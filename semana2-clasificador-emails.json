      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of items) {\n  const texto = item.json.content[0].text;\n\n  let clasificacion;\n  try {\n    clasificacion = JSON.parse(texto);\n  } catch (e) {\n    clasificacion = {\n      categoria: 'error',\n      urgencia: 'baja',\n      resumen: 'Claude no devolvió JSON válido',\n      accion_recomendada: 'Revisar manualmente'\n    };\n  }\n\n  item.json = {\n    email: {\n      asunto:    $('Mensaje a JSON').first().json.asunto,\n      remitente: $('Mensaje a JSON').first().json.remitente,\n    },\n    clasificacion: clasificacion,\n    timestamp: new Date().toISOString(),\n  };\n}\n\nreturn items;"
      },
