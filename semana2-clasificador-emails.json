        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nfor (const item of items) {\n  const { asunto, cuerpo, remitente } = item.json.body;\n\n  if (!asunto?.trim() || !cuerpo?.trim()) {\n    throw new Error('asunto y cuerpo son obligatorios');\n  }\n\n  item.json = {\n    asunto:    asunto.trim(),\n    cuerpo:    cuerpo.trim(),\n    remitente: remitente?.trim() || 'desconocido',\n    timestamp: new Date().toISOString(),\n  };\n}\n\nreturn items;"
